<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Brainrot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
    <!-- Used when the app's theme is set to Light or Dark instead of following the system -->
    <style name="Theme.Brainrot.SplashLight">
        <item name="android:windowSplashScreenBackground">@color/icon_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <style name="Theme.Brainrot.SplashDark">
        <item name="android:windowSplashScreenBackground">@color/dark_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_dark</item>
    </style>
</resources>
