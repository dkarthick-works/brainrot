meta {
  name: review_flashcard
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: inherit
}

headers {
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 6,
    "method": "tools/call",
    "params": {
      "name": "review_flashcard",
      "arguments": {
        "id": "{{cardId}}",
        "quality": 4
      }
    }
  }
}
