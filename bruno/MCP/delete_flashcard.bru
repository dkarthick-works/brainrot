meta {
  name: delete_flashcard
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: inherit
}

headers {
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 8,
    "method": "tools/call",
    "params": {
      "name": "delete_flashcard",
      "arguments": {
        "id": "{{cardId}}"
      }
    }
  }
}
