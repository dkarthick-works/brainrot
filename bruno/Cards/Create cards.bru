meta {
  name: Create cards
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/cards
  body: json
  auth: inherit
}

body:json {
  {
    "cards": [
      { "question": "What does SM-2 stand for?", "answer": "SuperMemo 2" },
      { "question": "Minimum SM-2 ease factor?", "answer": "1.3" }
    ]
  }
}

script:post-response {
  if (res.body.created?.length) bru.setEnvVar("cardId", res.body.created[0].id);
}

docs {
  Add `"topicId": "..."` at the top level to create in a topic; omitted means Default. Max 100 cards. Duplicate questions are returned in `skipped`.
}
